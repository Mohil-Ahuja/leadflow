# SQLAlchemy URL. SQLite works out of the box; Docker Compose uses Postgres:
#   postgresql+psycopg://leadflow:leadflow@db:5432/leadflow
DATABASE_URL=sqlite:///./leadflow.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Fill an empty database with demo leads on startup.
SEED_ON_STARTUP=false
