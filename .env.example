# Used by docker-compose.yml. Copy to .env to override; every value has a default.

POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# Fill the empty database with 10 demo leads on first start.
SEED_ON_STARTUP=true

# Timezone the seed uses to decide what "today" is. Set it to yours.
TZ=Asia/Kolkata

# Service-level variables live in backend/.env.example and frontend/.env.example.
